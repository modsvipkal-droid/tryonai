# ==============================================================================
# SERVER-SIDE ONLY SECRETS (NO NEXT_PUBLIC_ PREFIX - NEVER EXPOSED TO CLIENT)
# ==============================================================================

# Admin password for /manageadminbhai
ADMIN_PASSWORD="your_admin_password"

# IP whitelist for admin panel (comma-separated). All other IPs get 404.
ALLOWED_IPS="your.public.ip.here"

# MongoDB Database Connection String (Server-side only)
MONGODB_URI="mongodb+srv://user:password@cluster.example.mongodb.net/kalmods21_db?retryWrites=true&w=majority"
MONGODB_DB="kalmods21_db"

# Firebase Private / Backend Authentication (Server-side verification)
FIREBASE_DATABASE_URL="https://your_project-default-rtdb.firebaseio.com"
FIREBASE_API_KEY="your_private_api_key"
FIREBASE_ADMIN_KEY="your_firebase_admin_service_account_json_or_key"

# Cloudflare Turnstile Secret Key (Server-side verification)
TURNSTILE_SECRET_KEY="your_turnstile_secret_key"

# Fampay UPI Payment Gateway (Server-side only)
FAMPAY_API_KEY="your_fampay_api_key"
FAMPAY_QR_URL="https://fampay.anujbots.xyz/api/qr.php"
FAMPAY_VERIFY_URL="https://fampay.anujbots.xyz/api/verify.php"
FAMPAY_UPI_ID="biswajitbhai@fam"

# ==============================================================================
# PUBLIC CLIENT CONFIGURATION (NEXT_PUBLIC_ PREFIX - SAFE FOR BROWSER)
# ==============================================================================

# Cloudflare Turnstile Public Site Key (Rendered in browser widget)
NEXT_PUBLIC_TURNSTILE_SITE_KEY="your_turnstile_site_key"

# Firebase Client Web Configuration (Public Project Identifiers)
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your_project.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="your_project_id"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="your_project.firebasestorage.app"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="your_sender_id"
NEXT_PUBLIC_FIREBASE_APP_ID="your_app_id"
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID="your_measurement_id"
